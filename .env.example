# Server-only configuration. Keep real values in .env.local or the deployment secret store.
NIM_API_KEY=
NIM_MODEL_ID=meta/llama-3.1-8b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# PostgreSQL is the persistent application store. Use a private deployment secret.
DATABASE_URL=
AGENTFLOW_DEMO_ORGANIZATION_ID=org_haven_home_demo
AGENTFLOW_DEMO_CUSTOMER_ID=customer-haven-repeat

# Shopify connector: the domain is public; tokens and secrets remain server-side only.
SHOPIFY_STORE_DOMAIN=haven-home-k1gerlw9.myshopify.com
SHOPIFY_API_VERSION=2025-10
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_SECRET=
SHOPIFY_UCP_PROFILE_URL=
AGENTFLOW_PUBLIC_URL=
SHOPIFY_UCP_VERSION=2026-04-08
SHOPIFY_APP_PROXY_PREFIX=apps
SHOPIFY_APP_PROXY_SUBPATH=agentflow
SHOPIFY_UCP_DEFAULT_COUNTRY=US

# Safe demo adapters remain the default until live credentials are configured.
PAYMENT_PROVIDER=mock
CATALOG_PROVIDER=demo
LLM_PROVIDER=nim
DEMO_MODE=true
AGENT_TOTAL_TIMEOUT_MS=25000
AGENT_STEP_TIMEOUT_MS=8000
AGENT_TOOL_TIMEOUT_MS=8000
