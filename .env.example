# Server-only configuration. Keep real values in .env.local or the deployment secret store.
NIM_API_KEY=
NIM_MODEL_ID=meta/llama-3.3-70b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Shopify connector: the domain is public; tokens remain server-side only.
SHOPIFY_STORE_DOMAIN=u2xwzd-kc.myshopify.com
SHOPIFY_API_VERSION=2025-10
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Safe demo adapters remain the default until live credentials are configured.
PAYMENT_PROVIDER=mock
CATALOG_PROVIDER=shopify
LLM_PROVIDER=nim
DEMO_MODE=true
